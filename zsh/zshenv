setopt no_global_rcs

# Cross-platform PATH setup
if [[ "$OSTYPE" == darwin* ]]; then
    # macOS with Homebrew
    export PATH=.:$HOME/bin:/opt/nflx/bin:$HOME/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/opt/ccache/libexec:/usr/local/opt/coreutils/libexec/gnubin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/X11/bin:/Library/TeX/texbin:./node_modules/.bin:$HOME/Library/Python/3.7/bin
    export HOMEBREW_PREFIX="/opt/homebrew"
    export HOMEBREW_CELLAR="/opt/homebrew/Cellar"
    export HOMEBREW_REPOSITORY="/opt/homebrew"
    export MANPATH="/opt/homebrew/share/man${MANPATH+:$MANPATH}:"
    export INFOPATH="/opt/homebrew/share/info:${INFOPATH:-}"
else
    # Linux/WSL
    export PATH=.:$HOME/bin:$HOME/.local/bin:$HOME/.local/share/nvim/mason/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:./node_modules/.bin
fi
#history base for per directory history
export HISTORY_BASE=$HOME/.directory_history
export HISTFILE=$HOME/.zsh_history
export R_KEEP_PKG_SOURCE=yes
#export MAKEFLAGS=-j16

# Workaround for nvim terminal issues with <C-H>
# https://github.com/neovim/neovim/issues/2048#issuecomment-78045837
# infocmp $TERM | sed 's/kbs=^[hH]/kbs=\\177/' > $TERM.ti
# tic $TERM.ti
export TERMINFO="$HOME/.terminfo"
#export NOT_CRAN="true"

# hopefully fixes claude code flickering
export ENABLE_INCREMENTAL_TUI=true

# Claude Code: use max effort by default (only valid for Opus)
export CLAUDE_CODE_EFFORT_LEVEL=max
export MAX_THINKING_TOKENS=127999 # this is the max output tokens - 1 https://platform.claude.com/docs/en/about-claude/models/overview#latest-models-comparison
export CLAUDE_CODE_DISABLE_ADAPTIVE_THINKING=1

# Disable Vercel plugin telemetry in Claude Code
export VERCEL_PLUGIN_TELEMETRY=off

# llm-panel: override stale defaults (nf-gemini-pro doesn't exist)
# Update periodically: `llm models | grep nflx` to find latest
export LLM_PANEL_MODELS="nflx/gpt-5.2,nflx/claude-opus-4-6,nflx/gemini-3.1-pro-preview"

# Source local secrets if they exist (API keys, etc.)
[[ -f ~/.zshenv.local ]] && source ~/.zshenv.local
