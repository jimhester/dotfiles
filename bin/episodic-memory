#!/usr/bin/env bash
# Runs the episodic-memory CLI, its MCP server over stdio with
# `episodic-memory mcp`, or one MCP server shared by every agent over HTTP with
# `episodic-memory serve [--port N]` (run by the episodic-memory systemd user
# service), under a Node that better-sqlite3 supports. Installs dependencies on
# first run and rebuilds the native binding whenever the Node ABI changes.
#
# better-sqlite3 12.x supports Node 20-25 and does not compile on Node 26, so
# prefer Homebrew's node@24 keg (stable path across patch upgrades) over
# whatever `node` is on PATH. Override with EPISODIC_MEMORY_NODE.
#
# stdout belongs to the MCP protocol in `mcp` mode: setup output goes to stderr.

set -euo pipefail

EM_DIR="${EPISODIC_MEMORY_DIR:-$HOME/p/episodic-memory}"

find_node() {
  if [[ -n "${EPISODIC_MEMORY_NODE:-}" ]]; then
    echo "$EPISODIC_MEMORY_NODE"
    return
  fi
  local prefix
  for prefix in "${HOMEBREW_PREFIX:-}" /opt/homebrew /usr/local /home/linuxbrew/.linuxbrew; do
    if [[ -n "$prefix" && -x "$prefix/opt/node@24/bin/node" ]]; then
      echo "$prefix/opt/node@24/bin/node"
      return
    fi
  done
  command -v node || { echo "episodic-memory: no node found; set EPISODIC_MEMORY_NODE" >&2; exit 1; }
}

NODE="$(find_node)"
# npm and node-gyp must build against the same Node that will load the binding.
export PATH="$(dirname "$NODE"):$PATH"

if [[ ! -d "$EM_DIR" ]]; then
  echo "episodic-memory: $EM_DIR not found; run ~/dotfiles/bin/setup-episodic-memory" >&2
  exit 1
fi

MARKER="$EM_DIR/node_modules/.node_abi_version"
ABI="$("$NODE" -p process.versions.modules)"

# The marker is written only after success, so an interrupted install retries.
if [[ ! -f "$MARKER" ]]; then
  echo "episodic-memory: installing dependencies with Node $("$NODE" -v)..." >&2
  (cd "$EM_DIR" && npm install) >&2
  echo "$ABI" > "$MARKER"
elif [[ "$(cat "$MARKER")" != "$ABI" ]]; then
  echo "episodic-memory: Node ABI changed ($(cat "$MARKER") -> $ABI); rebuilding better-sqlite3..." >&2
  (cd "$EM_DIR" && "$NODE" scripts/postinstall.js) >&2
  echo "$ABI" > "$MARKER"
elif ! (cd "$EM_DIR" && "$NODE" -e "new (require('better-sqlite3'))(':memory:').close()") >/dev/null 2>&1; then
  # e.g. a `git pull`/`npm install` run under a different Node replaced it.
  echo "episodic-memory: better-sqlite3 binding is missing or stale; rebuilding..." >&2
  (cd "$EM_DIR" && "$NODE" scripts/postinstall.js) >&2
fi

if [[ "${1:-}" == "mcp" ]]; then
  shift
  exec "$NODE" "$EM_DIR/cli/mcp-server-wrapper.js" "$@"
fi
if [[ "${1:-}" == "serve" ]]; then
  shift
  exec "$NODE" "$EM_DIR/dist/mcp-server.js" --http "$@"
fi
exec "$NODE" "$EM_DIR/cli/episodic-memory.js" "$@"
