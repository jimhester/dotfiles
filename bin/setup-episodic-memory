#!/usr/bin/env bash
# Installs episodic-memory and wires it into Oh My Pi (omp):
#   - clones obra/episodic-memory to $EPISODIC_MEMORY_DIR (default ~/p/episodic-memory)
#   - links the bin/episodic-memory wrapper to ~/.local/bin
#   - links omp/hooks/post (session_start/session_shutdown sync) into omp
#   - registers the episodic-memory MCP server in omp's mcp.json
#
# Safe to re-run. Called from setup.sh.

set -euo pipefail

DOTFILES_DIR="$HOME/dotfiles"
EM_DIR="${EPISODIC_MEMORY_DIR:-$HOME/p/episodic-memory}"
OMP_AGENT_DIR="${OMP_HOME:-$HOME/.omp}/agent"
WRAPPER="$HOME/.local/bin/episodic-memory"

make_link() {
  mkdir -p "${1%/*}"
  if [[ -h "$1" ]]; then
    rm "$1"
  elif [[ -e "$1" ]]; then
    mv "$1" "$1.bak"
  fi
  ln -s "$2" "$1"
}

# better-sqlite3 does not compile on Node 26; the wrapper prefers node@24.
if [[ "$OSTYPE" == darwin* ]]; then
  brew install node@24
elif [[ -z "${EPISODIC_MEMORY_NODE:-}" ]]; then
  echo "Linux: install Node 20-25 and set EPISODIC_MEMORY_NODE if it is not node@24 from Homebrew or the default node." >&2
fi

if [[ ! -d "$EM_DIR" ]]; then
  git clone https://github.com/obra/episodic-memory.git "$EM_DIR"
fi

make_link "$WRAPPER" "$DOTFILES_DIR/bin/episodic-memory"

# First run installs dependencies and builds the native binding.
"$WRAPPER" --help >/dev/null

# omp skips symlinked hook files, so link the directory instead.
make_link "$OMP_AGENT_DIR/hooks/post" "$DOTFILES_DIR/omp/hooks/post"

# mcp.json also holds machine-specific servers; merge only our entry.
MCP_JSON="$OMP_AGENT_DIR/mcp.json"
[[ -f "$MCP_JSON" ]] || echo '{"mcpServers": {}}' > "$MCP_JSON"
tmp="$(mktemp)"
jq --arg cmd "$WRAPPER" \
  '.mcpServers["episodic-memory"] = {type: "stdio", command: $cmd, args: ["mcp"]}' \
  "$MCP_JSON" > "$tmp"
mv "$tmp" "$MCP_JSON"

echo "episodic-memory ready: MCP server and session sync hook registered in $OMP_AGENT_DIR"
