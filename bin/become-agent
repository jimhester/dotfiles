#!/bin/bash
# Run a command as the claude-agent user.
# Usage: become-agent [--browser] <user> [command ...]
#        become-agent <user>              # defaults to: claude --permission-mode auto --effort max
#        become-agent --browser           # also start a headed CDP Chrome and point
#                                          # the agent's Playwright MCP at it (for
#                                          # Meechum/SSO-authenticated automation)
#
# Requires sudoers entry: jimhester ALL=(claude-agent) NOPASSWD: SETENV: ALL

if [[ -n "${BECOME_AGENT_DEBUG:-}" ]]; then
    exec 3>/tmp/become-agent-debug.log
    BASH_XTRACEFD=3
    PS4='+ [$(date "+%H:%M:%S")] '
    set -x
fi
set -euo pipefail
dbg() { [[ -n "${BECOME_AGENT_DEBUG:-}" ]] && echo "[$(date '+%H:%M:%S')] $*" >&3 || :; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Parse our own wrapper flags — only as LEADING args, before <user>/command, so
# a --browser meant for the downstream command is never consumed. Use `--` to
# end wrapper-flag parsing explicitly.
BROWSER_MODE=""
while [[ $# -gt 0 ]]; do
    case "$1" in
        --browser) BROWSER_MODE=1; shift ;;
        --)        shift; break ;;
        *)         break ;;
    esac
done

AGENT_USER="${1:-claude-agent}"
shift 2>/dev/null || true

if [[ $# -eq 0 ]]; then
    set -- claude --permission-mode auto --effort max
fi

# Environment variables to pass through to the agent process
PRESERVE_ENV="ANTHROPIC_API_KEY"
PRESERVE_ENV="${PRESERVE_ENV},ANTHROPIC_BASE_URL"
PRESERVE_ENV="${PRESERVE_ENV},CLAUDE_CODE_EFFORT_LEVEL"
PRESERVE_ENV="${PRESERVE_ENV},CLAUDE_CODE_ENABLE_TELEMETRY"
PRESERVE_ENV="${PRESERVE_ENV},CLAUDE_CODE_SUBAGENT_MODEL"
PRESERVE_ENV="${PRESERVE_ENV},OTEL_EXPORTER_OTLP_ENDPOINT"
PRESERVE_ENV="${PRESERVE_ENV},CONNECT_API_KEY"
PRESERVE_ENV="${PRESERVE_ENV},CONNECT_TEST_API_KEY"
PRESERVE_ENV="${PRESERVE_ENV},OPENAI_API_KEY"
PRESERVE_ENV="${PRESERVE_ENV},OPENAI_BASE_URL"
PRESERVE_ENV="${PRESERVE_ENV},TABLEAU_PAT"
PRESERVE_ENV="${PRESERVE_ENV},MODEL_GATEWAY_PROJECT_ID"
PRESERVE_ENV="${PRESERVE_ENV},GOOGLE_API_KEY"
PRESERVE_ENV="${PRESERVE_ENV},TERM"
PRESERVE_ENV="${PRESERVE_ENV},LANG"
PRESERVE_ENV="${PRESERVE_ENV},ENABLE_INCREMENTAL_TUI"
PRESERVE_ENV="${PRESERVE_ENV},WORK_WORKER_ID"
PRESERVE_ENV="${PRESERVE_ENV},WORK_DB_PATH"
PRESERVE_ENV="${PRESERVE_ENV},GH_ENTERPRISE_TOKEN"

# Read gh token from primary user's keychain so the agent gets it via env var.
# GH_ENTERPRISE_TOKEN is used by gh CLI for GitHub Enterprise (github.netflix.net).
# Uses timeout to avoid blocking on a locked keychain (which shows a macOS
# "security wants to use the login keychain" dialog).
if [[ -z "${GH_ENTERPRISE_TOKEN:-}" ]]; then
    dbg "fetching GH_ENTERPRISE_TOKEN via gh auth token..."
    GH_ENTERPRISE_TOKEN=$(timeout 2 gh auth token --hostname github.netflix.net 2>/dev/null || true)
    export GH_ENTERPRISE_TOKEN
    if [[ -z "$GH_ENTERPRISE_TOKEN" ]]; then
        dbg "WARNING: could not read gh token (keychain locked?). gh commands may fail."
    fi
fi

# Browser mode: start (or reuse) a headed CDP Chrome as the primary user — who
# has the GUI session — BEFORE dropping to the agent, then hand the agent the
# endpoint. Only --browser may set PLAYWRIGHT_MCP_CDP_ENDPOINT: scrub any
# inherited value otherwise so a stray env var can't silently flip the agent
# into connect mode. This is an intentional trust elevation (the agent can act
# as you in that browser) — see docs/claude-agent-browser-automation.md.
unset PLAYWRIGHT_MCP_CDP_ENDPOINT 2>/dev/null || true
if [[ -n "${BROWSER_MODE}" ]]; then
    if ! "${SCRIPT_DIR}/chrome-debug-session"; then
        echo "ERROR: --browser requested but chrome-debug-session failed." >&2
        exit 1
    fi
    # chrome-debug-session uses a random port; read the one Chrome chose.
    PROFILE_DIR="${CHROME_DEBUG_PROFILE:-${HOME}/.cache/claude-agent-chrome}"
    CDP_PORT=""
    [[ -f "${PROFILE_DIR}/DevToolsActivePort" ]] && \
        IFS= read -r CDP_PORT < "${PROFILE_DIR}/DevToolsActivePort" || true
    if [[ -z "${CDP_PORT}" ]]; then
        echo "ERROR: could not read CDP port from ${PROFILE_DIR}/DevToolsActivePort." >&2
        exit 1
    fi
    export PLAYWRIGHT_MCP_CDP_ENDPOINT="http://127.0.0.1:${CDP_PORT}"
    PRESERVE_ENV="${PRESERVE_ENV},PLAYWRIGHT_MCP_CDP_ENDPOINT"
    dbg "browser mode: CDP=${PLAYWRIGHT_MCP_CDP_ENDPOINT}"
fi

# sudo resets PATH to secure defaults regardless of --preserve-env,
# so we inject the agent's PATH explicitly via env(1).
AGENT_HOME=$(dscl . -read "/Users/${AGENT_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
AGENT_HOME="${AGENT_HOME:-/Users/${AGENT_USER}}"
AGENT_PATH="${AGENT_HOME}/.local/bin:/opt/nflx/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"

dbg "AGENT_HOME=${AGENT_HOME}"
dbg "GH_ENTERPRISE_TOKEN length=${#GH_ENTERPRISE_TOKEN}"
dbg "exec sudo -u ${AGENT_USER} ... $*"

exec sudo -u "${AGENT_USER}" \
    --set-home \
    "--preserve-env=${PRESERVE_ENV}" \
    -- env "PATH=${AGENT_PATH}" "GH_HOST=github.netflix.net" "$@"
